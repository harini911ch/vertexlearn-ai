{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "NodeNext",
    "target": "ES2022",
    "moduleResolution": "NodeNext",

    "types": ["node"],
    "esModuleInterop": true,

    "sourceMap": true,

    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}